# Hand-written sample of a workspace root Cargo.toml.
# Named .sample so that cargo and its tools do not take it for a package of this repository.
[workspace]
members = ["crates/*", "xtask"]

[workspace.package]
rust-version = "1.85"

[workspace.dependencies]
tokio = { version = "1.38", features = ["full"] }

[package]
name = "demo"
version = "0.1.0"
rust-version.workspace = true

[dependencies]
serde = "1.0"
json = { package = "serde_json", version = "1.0" }
tokio = { workspace = true }
local = { path = "../local" }
widget = { git = "https://github.com/acme/widget" }

[dev-dependencies]
proptest = "1.4"

[build-dependencies]
cc = "1.0"

[target.'cfg(unix)'.dependencies]
libc = "0.2"
